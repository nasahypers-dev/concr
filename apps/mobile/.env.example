# CONCR mobile environment. Copy to `.env` (never committed). Only EXPO_PUBLIC_* variables reach the app bundle.

EXPO_PUBLIC_API_MODE=mock
# mock (default): in-memory data from @concr/shared fixtures, no backend needed; OTP is always 123456.
# http: real API (arrives in Phase B2).

EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
# Base URL of the API as seen FROM THE PHONE. `localhost` does not work on a device: use your laptop's
# LAN IP (Windows: ipconfig, macOS: ipconfig getifaddr en0). Phone and laptop must share the Wi-Fi.
# Restart `npm run dev:mobile` after changing this file.
