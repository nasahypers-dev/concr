# CONCR API environment. Copy to `.env` (never committed). Every variable is validated at boot by src/config/env.ts.

NODE_ENV=development
# development | test | production

PORT=3000
# HTTP port. The dispatcher panel and the mobile app expect http://<host>:3000/api/v1

LOG_LEVEL=debug
# fatal | error | warn | info | debug | trace | silent. Pretty-printed in development, JSON otherwise.

DATABASE_URL=postgresql://concr:concr@127.0.0.1:5432/concr?schema=public
# PostgreSQL 16 + PostGIS from infra/docker-compose.yml (127.0.0.1 rather than localhost: instant failure when down)

REDIS_URL=redis://127.0.0.1:6379
# Redis 7 from infra/docker-compose.yml

CORS_ORIGINS=http://localhost:3001
# Comma-separated browser origins allowed by CORS (dispatcher panel dev server)

DEFAULT_SUPPLIER_ID=00000000-0000-0000-0000-000000000000
# Supplier used for customer orders in MVP (customers do not choose a supplier).
# TODO(nurlan): replace with the supplier id printed by the Phase 1 seed.
