{
  "name": "@concr/shared",
  "version": "0.1.0",
  "private": true,
  "description": "CONCR shared enums, error codes, zod schemas and i18n resources",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./i18n/*": "./i18n/*.json"
  },
  "files": [
    "dist",
    "i18n"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --ci"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.14"
  }
}
